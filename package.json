{
  "name": "clinova-core-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:analyze": "vite build --config vite.config.analyze.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:migrate": "supabase db reset",
    "supabase:status": "supabase db lint",
    "db:seed": "tsx scripts/seedExistingDb.ts",
    "db:seed:notes": "tsx scripts/seedDiseaseNotes.ts",
    "db:validate": "tsx scripts/validateDb.ts",
    "lint:check-phrases": "bash scripts/check-phrases-simple.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.2",
    "supermemory": "^4.24.12",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "resolutions": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.64.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!server.ts": "git add",
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@google/genai@2.10.0": true,
    "core-js@3.49.0": true,
    "protobufjs@7.6.4": true,
    "msw@2.15.0": true,
    "husky@9.1.7": true
  }
}
