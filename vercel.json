{
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push/daily",
      "schedule": "0 5 * * *",
      "method": "POST",
      "timezone": "UTC",
      "headers": {
        "Authorization": "Bearer ${PUSH_CRON_SECRET}"
      }
    }
  ]
}
