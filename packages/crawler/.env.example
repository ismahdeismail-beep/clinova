# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/clinova

# Storage Provider: "supabase" or "cloudinary"
STORAGE_PROVIDER=supabase

# Cloudinary (if using cloudinary storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Crawler Settings
MAX_CONCURRENT_DOWNLOADS=10
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5
IMAGE_MIN_WIDTH=400
IMAGE_MIN_HEIGHT=400
MAX_FILE_SIZE_KB=200
INCREMENTAL_ONLY=true
Crawl_BATCH_SIZE=50

# Image Providers (comma-separated)
PROVIDERS=wikimedia,openi,nih,nci