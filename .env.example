# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary Configuration (Optional - for file uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Sync Configuration (Optional - for cloud backup)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Backend (Local dev stack / OpenCode CLI + seed & validation scripts)
# Local defaults match supabase/config.toml. Override for a hosted project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used by psql-based validation/seed scripts)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google Gemini AI Config (Required - for patient extraction & clinical reviews)
GEMINI_API_KEY=
# Fallback API keys for quota rotation (Optional)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Multi-Provider AI Architecture (Optional)
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
JINA_API_KEY=
NIH_API_KEY=

# Admin & Security (Optional — locks down write endpoints)
ADMIN_API_SECRET=
# When set, /api/admin/* routes require x-admin-secret header

# AI rate limiting (always-on, default 60 req/min per IP)
AI_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW_MS=60000

# Opt-in global rate limiting & shared-secret auth for API routes
RATE_LIMIT_ENABLED=false
API_REQUIRE_AUTH=false
API_SHARED_SECRET=

# Sentry Error Monitoring (Optional - leave blank to disable)
VITE_SENTRY_DSN=
SENTRY_DSN=


# Vercel Cron → /api/push/daily gate (NOT committed; set in Vercel env too).
PUSH_CRON_SECRET=

# WhatsApp Cloud API bot (Optional — enables /api/whatsapp/incoming RAG replies)
# GET-subscription verification token (any random string; enter the same value in
# the Meta app's webhook settings).
WHATSAPP_VERIFY_TOKEN=
# Graph API access token + the phone number id that receives messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# App Secret — when set, inbound POSTs must carry a valid X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Per-phone reply throttle + how many chunks to ground each answer in.
WHATSAPP_RATE_LIMIT_MAX=10
WHATSAPP_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_RAG_TOP_K=3

# ---- open-source WhatsApp bot (optional; no Meta account / token required) ----
# Baileys links a normal WhatsApp number by QR code and answers from the same
# RAG path. Start with: npm run wa:link
# Directory holding the device pairing state (gitignored; regenerate by re-linking).
WHATSAPP_OPEN_AUTH_DIR=.whatsapp-auth
# 1 = compute RAG answers and print them, but never send a message.
WHATSAPP_OPEN_DRY_RUN=false
# 1 = also reply inside groups (off by default: a group reply is broadcast to
# every participant).
WHATSAPP_OPEN_ALLOW_GROUPS=false
# 1 = show Baileys' own logging (socket-level detail).
WHATSAPP_OPEN_DEBUG=false
# Defaults fall back to the Cloud API values above when left empty.
WHATSAPP_OPEN_TOP_K=
WHATSAPP_OPEN_RATE_LIMIT_MAX=
WHATSAPP_OPEN_RATE_LIMIT_WINDOW_MS=

# RAG serving path (both WhatsApp transports).
# The whole knowledge_chunks corpus is held in memory so every query ranks all
# of it; this is how long a loaded copy stays fresh before it is re-read.
RAG_INDEX_TTL_MS=600000
