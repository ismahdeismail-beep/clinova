{
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push/daily?secret=2ZTRWKCJP3VApdwkYt0HziGNoQnEjBab",
      "schedule": "0 5 * * *"
    }
  ]
}
